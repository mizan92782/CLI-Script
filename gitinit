#!/bin/bash

# ==============================================================================
# Git Repository Initializer (gitinit)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "==================================================="
echo "          🚀 GIT REPOSITORY INITIALIZER            "
echo "==================================================="

# If already initialized, delegate to gitpush
if [ -d ".git" ]; then
    echo "ℹ Git repository already initialized in $(pwd)."
    read -p "Do you want to stage, commit, and push changes now? [Y/n]: " proceed_push
    if [[ "$proceed_push" =~ ^[Yy]$ || -z "$proceed_push" ]]; then
        bash "$SCRIPT_DIR/gitpush" "$@"
    fi
    exit 0
fi

# 1. Initialize
echo "Initializing new Git repository..."
git init
git branch -M main
echo "✔ Default branch set to 'main'."

# 2. Add default .gitignore if not present
if [ ! -f ".gitignore" ]; then
    echo "Creating basic .gitignore..."
    cat << 'EOF' > .gitignore
# Environment & Secrets
.env
.env.*
*.local

# Python
__pycache__/
*.py[cod]
venv/
env/
*.log

# System & IDE
.DS_Store
.idea/
.vscode/
EOF
    echo "✔ Default .gitignore created."
fi

# 3. Stage & Commit
echo "Staging all files..."
git add -A

read -p "Enter initial commit message (Default: 'Initial commit'): " init_msg
init_msg=${init_msg:-"Initial commit"}
git commit -m "$init_msg"
echo "✔ Initial commit created."

# 4. Optional Remote setup
echo ""
read -p "Do you have a remote Git URL to link now? (e.g. GitHub/GitLab) [y/N]: " has_remote
if [[ "$has_remote" =~ ^[Yy]$ ]]; then
    read -p "Enter remote repository URL: " remote_url
    if [ -n "$remote_url" ]; then
        git remote add origin "$remote_url"
        echo "✔ Remote 'origin' linked: $remote_url"
        read -p "Push initial commit to origin/main now? [Y/n]: " push_now
        if [[ "$push_now" =~ ^[Yy]$ || -z "$push_now" ]]; then
            git push -u origin main
            echo "✔ Initial push complete!"
        fi
    fi
fi

echo "==================================================="
echo "🎉 Git repository setup complete!"
echo "==================================================="
