log_success ".gitignore and .dockerignore created."

# --- Step 7: Create Dockerfile and entrypoint.sh ---
log_step "[7/8] Creating Dockerfile and entrypoint.sh..."

cat << 'EOF' > Dockerfile
# Base Image: Official Python 3.12 Slim
FROM python:3.12-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Set work directory
WORKDIR /app

# Install system dependencies needed for psycopg2, curl, build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
RUN pip install --upgrade pip
COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY . /app/

# Copy and set entrypoint permissions
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose standard port
EXPOSE 8000

# Default entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Default command for development (overridden in prod compose)
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
EOF

cat << 'EOF' > entrypoint.sh
#!/bin/sh

# ==============================================================================
# Django Docker Container Entrypoint
# Handles database connectivity wait, migrations, and static file collection
# ==============================================================================

set -e

if [ "$DB_ENGINE" = "django.db.backends.postgresql" ] || [ "$DB_HOST" = "db" ]; then
    echo "⏳ Waiting for PostgreSQL at $DB_HOST:${DB_PORT:-5432}..."

    python - << 'WAIT_FOR_DB'
import socket, sys, time, os
host = os.environ.get('DB_HOST', 'db')
port = int(os.environ.get('DB_PORT', 5432))
while True:
    try:
        with socket.create_connection((host, port), timeout=2):
            break
    except OSError:
        time.sleep(0.5)
WAIT_FOR_DB

    echo "✅ PostgreSQL is up and ready for connections!"
fi

# Run database migrations
echo "🔄 Running database migrations..."
python manage.py makemigrations --noinput
python manage.py migrate --noinput

# Collect static files in production or when STATIC_ROOT is configured
if [ "$DEBUG" = "False" ] || [ "$COLLECT_STATIC" = "1" ]; then
    echo "📦 Collecting static files..."
    python manage.py collectstatic --noinput --clear
fi

echo "🚀 Starting server..."
exec "$@"
EOF

chmod +x entrypoint.sh
log_success "Dockerfile and executable entrypoint.sh created."

# --- Step 8: Create docker-compose-dev.yml, docker-compose-prod.yml & Nginx ---
log_step "[8/8] Creating docker-compose files and Nginx reverse proxy configuration..."

# 8.1: Development Docker Compose
cat << EOF > docker-compose-dev.yml
services:
  db:
    image: postgres:16-alpine
    container_name: ${PROJECT_NAME}_db_dev
    restart: unless-stopped
    environment:
      POSTGRES_DB: \${DB_NAME:-django_db}
      POSTGRES_USER: \${DB_USER:-django_user}
      POSTGRES_PASSWORD: \${DB_PASSWORD:-django_password}
    ports:
      - "5432:5432"
    volumes:
      - postgres_dev_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \${DB_USER:-django_user} -d \${DB_NAME:-django_db}"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: ${PROJECT_NAME}_redis_dev
    restart: unless-stopped
    ports:
      - "6379:6379"

  web:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ${PROJECT_NAME}_web_dev
    command: python manage.py runserver 0.0.0.0:8000
    restart: unless-stopped
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    env_file:
      - .env
    environment:
      - DEBUG=True
      - DB_HOST=db
      - DB_PORT=5432
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started

volumes:
  postgres_dev_data:
EOF

# 8.2: Production Docker Compose
cat << EOF > docker-compose-prod.yml
services:
  db:
    image: postgres:16-alpine
    container_name: ${PROJECT_NAME}_db_prod
    restart: always
    environment:
      POSTGRES_DB: \${DB_NAME:-django_db}
      POSTGRES_USER: \${DB_USER:-django_user}
      POSTGRES_PASSWORD: \${DB_PASSWORD:-django_password}
    volumes:
      - postgres_prod_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \${DB_USER:-django_user} -d \${DB_NAME:-django_db}"]
      interval: 5s
      timeout: 5s
      retries: 5
    networks:
      - app_network

  redis:
    image: redis:7-alpine
    container_name: ${PROJECT_NAME}_redis_prod
    restart: always
    networks:
      - app_network

  web:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: ${PROJECT_NAME}_web_prod
    command: gunicorn ${PROJECT_NAME}.wsgi:application --bind 0.0.0.0:8000 --workers 3 --threads 2 --timeout 60
    restart: always
    volumes:
      - static_volume:/app/staticfiles
      - media_volume:/app/media
    env_file:
      - .env
    environment:
      - DEBUG=False
      - DB_HOST=db
      - COLLECT_STATIC=1
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_started
    networks:
      - app_network

  nginx:
    image: nginx:1.25-alpine
    container_name: ${PROJECT_NAME}_nginx_prod
    restart: always
    ports:
      - "80:80"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - static_volume:/app/staticfiles:ro
      - media_volume:/app/media:ro
    depends_on:
      - web
    networks:
      - app_network

networks:
  app_network:
    driver: bridge

volumes:
  postgres_prod_data:
  static_volume:
  media_volume:
EOF

# 8.3: Nginx Reverse Proxy Configuration
mkdir -p nginx
cat << 'EOF' > nginx/nginx.conf
upstream django_app {
    server web:8000;
}

server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    # Static files serving
    location /static/ {
        alias /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Media files serving
    location /media/ {
        alias /app/media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Proxy all other requests to Django Gunicorn
    location / {
        proxy_pass http://django_app;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_connect_timeout 60s;
        proxy_read_timeout 60s;
    }
}
EOF

log_success "docker-compose-dev.yml, docker-compose-prod.yml, and nginx/nginx.conf created."

# Provide symlinks for docker-compose dev/prod with dots for versatility
ln -sf docker-compose-dev.yml docker-compose.dev.yml 2>/dev/null || true
ln -sf docker-compose-prod.yml docker-compose.prod.yml 2>/dev/null || true

# --- Create Helper Run Scripts ---
cat << 'EOF' > dev.sh
#!/bin/bash
# Helper to start development environment with docker-compose
docker compose -f docker-compose-dev.yml up --build "$@"
EOF
chmod +x dev.sh

cat << 'EOF' > prod.sh
#!/bin/bash
# Helper to start production environment with docker-compose
docker compose -f docker-compose-prod.yml up -d --build "$@"
EOF
chmod +x prod.sh

# --- Summary and Instructions ---
