#!/bin/bash

# ==============================================================================
# Virtual Environment Manager (envrn)
# Robust Python venv creation, management, activation & package installer
# ==============================================================================

CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m'

VENV_DIR="${2:-venv}"

get_pip_cmd() {
    if [ -f "$VENV_DIR/bin/pip" ]; then
        PIP_CMD="$VENV_DIR/bin/pip"
    elif [ -n "$VIRTUAL_ENV" ]; then
        PIP_CMD="pip"
    else
        echo -e "${YELLOW}Virtual environment '$VENV_DIR' not found. Creating it first...${NC}"
        create_venv
        PIP_CMD="$VENV_DIR/bin/pip"
    fi
}

check_prerequisites() {
    if ! command -v python3 &> /dev/null; then
        echo -e "${RED}❌ Python 3 is not installed!${NC}"
        echo "Please install it: sudo apt update && sudo apt install -y python3 python3-pip python3-venv"
        exit 1
    fi

    if ! python3 -m venv --help &> /dev/null; then
        echo -e "${YELLOW}⚠ python3-venv is missing. Attempting installation...${NC}"
        if command -v sudo &> /dev/null; then
            sudo apt update && sudo apt install -y python3-venv python3-pip
        fi
    fi
}

create_venv() {
    check_prerequisites
    if [ -d "$VENV_DIR" ]; then
        echo -e "${YELLOW}Virtual environment already exists in '$VENV_DIR'.${NC}"
    else
        echo -e "${CYAN}Creating virtual environment in '$VENV_DIR'...${NC}"
        python3 -m venv "$VENV_DIR"
        echo -e "${GREEN}✔ Virtual environment created successfully at $(pwd)/$VENV_DIR${NC}"
    fi

    if [ -f "$VENV_DIR/bin/pip" ]; then
        echo "Upgrading pip, setuptools, and wheel..."
        "$VENV_DIR/bin/pip" install --upgrade pip setuptools wheel > /dev/null 2>&1
        echo -e "${GREEN}✔ Core build tools upgraded.${NC}"
    fi
    echo ""
    echo "To activate in your current terminal session, run:"
    echo -e "  ${BOLD}source $VENV_DIR/bin/activate${NC}"
}

activate_venv() {
    if [ -d "$VENV_DIR" ]; then
        echo -e "${GREEN}To activate virtual environment in your current shell, run:${NC}"
        echo -e "  ${BOLD}source $VENV_DIR/bin/activate${NC}"
        echo ""
        echo "Spawning subshell with active venv (type 'exit' to return)..."
        bash --rcfile <(echo "source $VENV_DIR/bin/activate")
    else
        echo -e "${RED}❌ Virtual environment '$VENV_DIR' not found.${NC}"
        echo "Create it first with: ./envrn create"
    fi
}

remove_venv() {
    if [ -d "$VENV_DIR" ]; then
        read -p "Are you sure you want to delete '$VENV_DIR'? [y/N]: " confirm
        if [[ "$confirm" =~ ^[Yy]$ ]]; then
            rm -rf "$VENV_DIR"
            echo -e "${GREEN}✔ Removed '$VENV_DIR'.${NC}"
        else
            echo "Cancelled."
        fi
    else
        echo "No directory '$VENV_DIR' found."
    fi
}

show_info() {
    if [ -f "$VENV_DIR/pyvenv.cfg" ]; then
        echo -e "${CYAN}===================================================${NC}"
        echo -e "${CYAN}          VIRTUAL ENVIRONMENT CONFIGURATION        ${NC}"
        echo -e "${CYAN}===================================================${NC}"
        echo "Location: $(pwd)/$VENV_DIR"
        echo "Python Executable: $(pwd)/$VENV_DIR/bin/python"
        echo "--- pyvenv.cfg ---"
        cat "$VENV_DIR/pyvenv.cfg"
        echo "------------------"
    else
        echo -e "${RED}Virtual environment '$VENV_DIR' not found.${NC}"
    fi
}

list_packages() {
    get_pip_cmd
    echo -e "${CYAN}Installed packages in '$VENV_DIR':${NC}"
    $PIP_CMD list
}

install_packages() {
    get_pip_cmd
    echo ""
    echo -e "${CYAN}===================================================${NC}"
    echo -e "${CYAN}         📦 SELECT PACKAGE GROUPS TO INSTALL       ${NC}"
    echo -e "${CYAN}===================================================${NC}"
    echo "  1) Core Django Stack           (Django, python-dotenv, psycopg2-binary)"
    echo "  2) REST API & JWT              (DRF, simplejwt, corsheaders, drf-spectacular)"
    echo "  3) FastAPI Stack               (FastAPI, uvicorn[standard], tortoise-orm, aerich)"
    echo "  4) Async & Background Tasks    (Celery, redis)"
    echo "  5) Database Helpers & Filters  (django-filter, django-import-export)"
    echo "  6) Production & Deployment     (gunicorn, whitenoise)"
    echo "  7) Development & Debugging     (django-extensions, django-debug-toolbar)"
    echo "  8) Media & Storage             (Pillow, django-storages)"
    echo "  9) 🚀 COMPLETE DJANGO+DRF SUITE(All Django & DRF groups 1, 2, 5, 6, 8)"
    echo " 10) Install from requirements.txt"
    echo ""
    read -p "Enter numbers separated by spaces (e.g. 1 2 6): " choices

    for choice in $choices; do
        case $choice in
            1)
                echo "🔹 Installing Core Django..."
                $PIP_CMD install "Django>=5.0,<6.0" python-dotenv psycopg2-binary
                ;;
            2)
                echo "🔹 Installing REST API & JWT..."
                $PIP_CMD install djangorestframework djangorestframework-simplejwt django-cors-headers drf-spectacular
                ;;
            3)
                echo "🔹 Installing FastAPI Stack..."
                $PIP_CMD install "fastapi>=0.110" "uvicorn[standard]>=0.28" "tortoise-orm>=0.20" aerich pydantic
                ;;
            4)
                echo "🔹 Installing Async & Celery..."
                $PIP_CMD install celery redis
                ;;
            5)
                echo "🔹 Installing Database Helpers & Filters..."
                $PIP_CMD install django-filter django-import-export
                ;;
            6)
                echo "🔹 Installing Production & Deployment..."
                $PIP_CMD install gunicorn whitenoise
                ;;
            7)
                echo "🔹 Installing Development & Debug Tools..."
                $PIP_CMD install django-extensions django-debug-toolbar ipython
                ;;
            8)
                echo "🔹 Installing Media & Storage..."
                $PIP_CMD install pillow django-storages
                ;;
            9)
                echo "🚀 Installing Complete Django + DRF Full Stack..."
                $PIP_CMD install "Django>=5.0,<6.0" djangorestframework djangorestframework-simplejwt \
                    django-cors-headers django-filter drf-spectacular python-dateutil pytz \
                    psycopg2-binary python-dotenv django-environ gunicorn whitenoise pillow
                ;;
            10)
                if [ -f "requirements.txt" ]; then
                    echo "📄 Installing from requirements.txt..."
                    $PIP_CMD install -r requirements.txt
                else
                    echo -e "${RED}requirements.txt not found in $(pwd)${NC}"
                fi
                ;;
            *)
                echo -e "${RED}Invalid choice: $choice${NC}"
                ;;
        esac
    done
    echo ""
    echo -e "${GREEN}✔ Selected packages installed successfully into '$VENV_DIR'!${NC}"
}

show_help() {
    echo ""
    echo "==================================================="
    echo "        🐍 VIRTUAL ENVIRONMENT MANAGER (envrn)     "
    echo "==================================================="
    echo "Usage: ./envrn [command] [venv_name]"
    echo ""
    echo "Commands:"
    echo "  create [name]      Create a new virtual environment (default: venv)"
    echo "  activate [name]    Activate or open subshell with active venv"
    echo "  install [name]     Install curated package groups into venv"
    echo "  list [name]        List installed packages (pip list)"
    echo "  info [name]        Show venv configuration & metadata"
    echo "  remove [name]      Delete virtual environment directory"
    echo "  --help, -h         Show this help message"
    echo ""
    echo "Examples:"
    echo "  ./envrn"
    echo "  ./envrn create"
    echo "  ./envrn install"
    echo "  ./envrn list"
    echo "  ./envrn create myenv"
    echo "==================================================="
    echo ""
}

# If no arguments passed, launch interactive menu
if [ -z "$1" ]; then
    while true; do
        clear
        echo -e "${CYAN}===================================================${NC}"
        echo -e "${CYAN}        🐍 PYTHON VIRTUAL ENVIRONMENT MENU         ${NC}"
        echo -e "${CYAN}===================================================${NC}"
        echo "Active directory: $(pwd)"
        if [ -d "$VENV_DIR" ]; then
            echo -e "Status: ${GREEN}Environment '$VENV_DIR' exists${NC}"
        else
            echo -e "Status: ${YELLOW}No '$VENV_DIR' found${NC}"
        fi
        echo ""
        echo "  1) Create Virtual Environment (venv)"
        echo "  2) Activate / Enter Environment (subshell)"
        echo "  3) Install Package Groups (Django, DRF, FastAPI, etc.)"
        echo "  4) List Installed Packages"
        echo "  5) Show Environment Info"
        echo "  6) Remove Virtual Environment"
        echo ""
        echo -e "${RED}  0) Exit${NC}"
        echo -e "${CYAN}===================================================${NC}"
        read -p "Select option [0-6]: " menu_choice
        echo ""

        case "$menu_choice" in
            1) create_venv ;;
            2) activate_venv ;;
            3) install_packages ;;
            4) list_packages ;;
            5) show_info ;;
            6) remove_venv ;;
            0) echo "Goodbye!"; exit 0 ;;
            *) echo -e "${RED}Invalid choice.${NC}" ;;
        esac

        echo ""
        read -p "Press Enter to return to menu..." _
    done
fi

case "$1" in
    create) create_venv ;;
    activate|env) activate_venv ;;
    install) install_packages ;;
    list) list_packages ;;
    info) show_info ;;
    remove|rm) remove_venv ;;
    --help|-h|help) show_help ;;
    *)
        echo "Unknown command '$1'. Use --help for usage."
        exit 1
        ;;
esac
