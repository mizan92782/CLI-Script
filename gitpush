#!/bin/bash

# ==============================================================================
# Automated Git Stage, Commit & Push Tool
# ==============================================================================

# Ensure inside a git repository
if [ ! -d ".git" ]; then
    echo "❌ Error: Not a git repository. Run 'git init' or './gitinit' first."
    exit 1
fi

show_git_help() {
    cat << 'EOF'
===================================================
             🚀 GIT COMMAND QUICK REFERENCE
===================================================
Basic Commands:
  git status               - Show working tree status
  git add .                - Stage all changes
  git commit -m "msg"      - Commit staged changes
  git log --oneline -n 5   - View recent commits

Branching:
  git branch               - List local branches
  git switch -c <name>     - Create and switch to new branch
  git checkout <name>      - Switch to existing branch

Remotes & Sync:
  git remote -v            - View configured remotes
  git pull origin <branch> - Fetch and merge remote changes
  git push origin <branch> - Push local commits to remote

Troubleshooting:
  git reset --soft HEAD~1  - Undo last commit but keep changes
  git stash / git stash pop- Temporarily shelf/restore uncommitted work
===================================================
EOF
}

if [[ "$1" == "--help" || "$1" == "-h" || "$1" == "help" ]]; then
    show_git_help
    exit 0
fi

echo "==================================================="
echo "              🚀 GIT AUTOMATION PUSH               "
echo "==================================================="

# 1. Show status
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "main")
echo "Current Branch: $CURRENT_BRANCH"
echo ""
echo "--- Working Tree Status ---"
git status -s
echo ""

# Check if there are changes
if [ -z "$(git status --porcelain)" ]; then
    echo "✔ Working tree is clean. Nothing to commit."
    read -p "Do you still want to push existing commits to remote? [y/N]: " push_only
    if [[ ! "$push_only" =~ ^[Yy]$ ]]; then
        exit 0
    fi
else
    # 2. Stage changes
    echo "Staging all changes (git add -A)..."
    git add -A
    git status -s
    echo ""

    # 3. Commit
    read -p "Enter commit message (Default: 'Update $(date +'%Y-%m-%d %H:%M')'): " mycommit
    mycommit=${mycommit:-"Update $(date +'%Y-%m-%d %H:%M')"}
    git commit -m "$mycommit"
    echo ""
fi

# 4. Branch management
echo "--- Local Branches ---"
git branch
echo ""

read -p "Do you want to create a new branch? [y/N]: " create_branch
if [[ "$create_branch" =~ ^[Yy]$ ]]; then
    read -p "Enter new branch name: " new_branch
    if [ -n "$new_branch" ]; then
        git checkout -b "$new_branch"
        CURRENT_BRANCH="$new_branch"
        echo "✔ Switched to new branch: $CURRENT_BRANCH"
    fi
fi

# 5. Push
read -p "Push to branch [$CURRENT_BRANCH]: " target_branch
target_branch=${target_branch:-$CURRENT_BRANCH}

# Check remote
if ! git remote | grep -q "origin"; then
    echo "No remote 'origin' found."
    read -p "Enter remote repository URL to add: " remote_url
    if [ -n "$remote_url" ]; then
        git remote add origin "$remote_url"
    fi
fi

echo "Pushing to origin/$target_branch..."
if git push -u origin "$target_branch"; then
    echo ""
    echo "✔ Git push completed successfully!"
else
    echo ""
    echo "⚠️ Push failed. The remote branch may have newer changes."
    read -p "Do you want to force push? (Caution: may overwrite remote commits) [y/N]: " force_push
    if [[ "$force_push" =~ ^[Yy]$ ]]; then
        git push -u origin "$target_branch" --force
        echo "✔ Force push completed."
    fi
fi
echo "==================================================="
