#!/bin/bash

# ==============================================================================
# Automated Full Nginx Server Setup (nginx_auto)
# Takes arguments for: Domain, Backend Port (Reverse Proxy), and SSL (Certbot)
# Automates: Installation, Systemd Enable, Firewall (80/443), Config, and SSL
# ==============================================================================

set -e

# --- Color Codes ---
GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Determine sudo
if [ "$EUID" -eq 0 ]; then
    SUDO=""
else
    SUDO="sudo"
fi

show_help() {
    cat << 'EOF'
===================================================
      🌐 AUTOMATED NGINX SERVER SETUP (nginx_auto)
===================================================
Usage:
  ./nginx_auto <domain> <port> [ssl_email]
  ./nginx_auto -d <domain> -p <port> [-e <email>] [--ssl]

Arguments:
  <domain>, -d       Domain or IP address (e.g. api.example.com, or '_' for default)
  <port>, -p         Backend port to reverse proxy (e.g. 8000, 3000, 5000)
  [ssl_email], -e    Admin email for automatic Let's Encrypt SSL certificate
  --ssl, -s          Enable SSL via Certbot (prompts for email if not provided)
  --help, -h         Show this help message

Examples:
  # 1. Reverse proxy to Django on port 8000:
  ./nginx_auto api.example.com 8000

  # 2. Reverse proxy + Auto Let's Encrypt SSL:
  ./nginx_auto api.example.com 8000 admin@example.com

  # 3. Default server reverse proxy on server IP:
  ./nginx_auto _ 8000

  # 4. Interactive mode (prompts for inputs):
  ./nginx_auto
===================================================
EOF
}

# --- Step 1: Parse Arguments ---
DOMAIN=""
PORT=""
SSL_EMAIL=""
ENABLE_SSL=false

# Check for help flag
for arg in "$@"; do
    if [[ "$arg" == "--help" || "$arg" == "-h" ]]; then
        show_help
        exit 0
    fi
done

# Parse flags or positional arguments
while [[ "$#" -gt 0 ]]; do
    case "$1" in
        -d|--domain) DOMAIN="$2"; shift 2 ;;
        -p|--port) PORT="$2"; shift 2 ;;
        -e|--email) SSL_EMAIL="$2"; ENABLE_SSL=true; shift 2 ;;
        -s|--ssl) ENABLE_SSL=true; shift ;;
        *)
            if [ -z "$DOMAIN" ]; then
                DOMAIN="$1"
            elif [ -z "$PORT" ]; then
                PORT="$1"
            elif [ -z "$SSL_EMAIL" ]; then
                SSL_EMAIL="$1"
                ENABLE_SSL=true
            fi
            shift
            ;;
    esac
done

# Terminal input helper (/dev/tty fallback for curl | bash)
read_input() {
    local prompt="$1"
    local var_name="$2"
    local default_val="$3"

    if [ -t 0 ]; then
        read -p "$prompt" val
    elif [ -e /dev/tty ]; then
        read -p "$prompt" val < /dev/tty
    else
        val=""
    fi
    val=${val:-$default_val}
    eval "$var_name=\"$val\""
}

# --- Step 2: Interactive Prompt if Arguments Omitted ---
if [ -z "$DOMAIN" ] || [ -z "$PORT" ]; then
    echo -e "${CYAN}===================================================${NC}"
    echo -e "${CYAN}      🌐 AUTOMATED NGINX SERVER CONFIGURATOR       ${NC}"
    echo -e "${CYAN}===================================================${NC}"
    echo "Please provide your setup parameters (press Enter for defaults):"
    echo ""

    if [ -z "$DOMAIN" ]; then
        DETECTED_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "_")
        read_input "Enter Domain Name (e.g. api.example.com, or '_' for IP: $DETECTED_IP) [default: _]: " DOMAIN "_"
    fi

    if [ -z "$PORT" ]; then
        read_input "Enter Backend Port to reverse proxy (e.g. 8000 for Django, 3000 for Node) [default: 8000]: " PORT "8000"
    fi

    if [ "$ENABLE_SSL" = false ] && [ "$DOMAIN" != "_" ] && [ "$DOMAIN" != "localhost" ]; then
        read_input "Do you want to configure free Let's Encrypt SSL (HTTPS)? [y/N]: " want_ssl "n"
        if [[ "$want_ssl" =~ ^[Yy]$ ]]; then
            ENABLE_SSL=true
            read_input "Enter admin email for SSL certificate notifications: " SSL_EMAIL ""
        fi
    fi
    echo ""
fi

# Validation
if [ -z "$DOMAIN" ]; then
    echo -e "${RED}Error: Domain is required!${NC}"
    exit 1
fi

if ! [[ "$PORT" =~ ^[0-9]+$ ]] || [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
    echo -e "${RED}Error: Port must be a valid integer between 1 and 65535 (received: '$PORT').${NC}"
    exit 1
fi

echo -e "${CYAN}===================================================${NC}"
echo -e "${BOLD}Target Configuration:${NC}"
echo -e "  Domain / Host:    ${GREEN}$DOMAIN${NC}"
echo -e "  Backend Target:   ${GREEN}http://127.0.0.1:$PORT${NC}"
echo -e "  SSL Certificate:  ${GREEN}$([ "$ENABLE_SSL" = true ] && echo "Yes (Certbot)" || echo "No (HTTP only)")${NC}"
[ -n "$SSL_EMAIL" ] && echo -e "  SSL Admin Email:  ${GREEN}$SSL_EMAIL${NC}"
echo -e "${CYAN}===================================================${NC}"
echo ""

# --- Step 3: Check and Install Nginx ---
echo -e "${BOLD}${CYAN}[1/5] Checking Nginx installation...${NC}"
if command -v nginx &> /dev/null; then
    NGINX_VERSION=$(nginx -v 2>&1)
    echo -e "${GREEN}✔ Nginx is already installed:${NC} $NGINX_VERSION"
else
    echo -e "${YELLOW}Nginx not found. Installing via apt-get...${NC}"
    $SUDO apt-get update -y
    $SUDO apt-get install -y nginx curl
    echo -e "${GREEN}✔ Nginx installed successfully.${NC}"
fi

# --- Step 4: Enable & Start Systemd Service ---
echo ""
echo -e "${BOLD}${CYAN}[2/5] Starting and enabling Nginx service...${NC}"

# Check and resolve Port 80/443 web server conflicts (Apache2, Caddy, Lighttpd)
for conflict_srv in apache2 caddy lighttpd; do
    if systemctl is-active --quiet "$conflict_srv" 2>/dev/null; then
        echo -e "${YELLOW}⚠ Port conflict detected: '$conflict_srv' is active and occupying Port 80.${NC}"
        echo "Stopping and disabling $conflict_srv to allow Nginx to bind to Port 80..."
        $SUDO systemctl stop "$conflict_srv" 2>/dev/null || true
        $SUDO systemctl disable "$conflict_srv" 2>/dev/null || true
        echo -e "${GREEN}✔ '$conflict_srv' stopped and disabled.${NC}"
    fi
done

# Check if another process is still holding port 80
if command -v ss &>/dev/null; then
    PORT_80_PROC=$(ss -tlpn 'sport = :80' 2>/dev/null | grep -v "nginx" | awk 'NR>1 {print $NF}')
    if [ -n "$PORT_80_PROC" ]; then
        echo -e "${YELLOW}⚠ Warning: Process ($PORT_80_PROC) is listening on Port 80.${NC}"
    fi
fi

$SUDO systemctl enable nginx

if ! systemctl is-active --quiet nginx; then
    echo "Starting Nginx..."
    if ! $SUDO systemctl start nginx; then
        echo -e "${RED}✖ Failed to start Nginx service.${NC}"
        echo -e "${YELLOW}Diagnostics from journalctl:${NC}"
        $SUDO journalctl -u nginx.service --no-pager -n 12 2>/dev/null || true
        exit 1
    fi
fi
echo -e "${GREEN}✔ Nginx service is active and enabled on boot.${NC}"

# --- Step 5: Expose Port 80 and 443 in Firewall ---
echo ""
echo -e "${BOLD}${CYAN}[3/5] Configuring firewall rules (Ports 80 & 443)...${NC}"
if command -v ufw &> /dev/null; then
    echo "Allowing 'Nginx Full' in UFW..."
    $SUDO ufw allow 'Nginx Full' > /dev/null 2>&1 || {
        $SUDO ufw allow 80/tcp
        $SUDO ufw allow 443/tcp
    }
    echo -e "${GREEN}✔ Ports 80 (HTTP) & 443 (HTTPS) exposed in UFW.${NC}"
elif command -v iptables &> /dev/null; then
    $SUDO iptables -A INPUT -p tcp --dport 80 -j ACCEPT 2>/dev/null || true
    $SUDO iptables -A INPUT -p tcp --dport 443 -j ACCEPT 2>/dev/null || true
    echo -e "${GREEN}✔ Ports 80 and 443 allowed in iptables.${NC}"
else
    echo -e "${YELLOW}ℹ No active firewall detected. Ports are open by default.${NC}"
fi

# --- Step 6: Generate Production Nginx Configuration ---
echo ""
echo -e "${BOLD}${CYAN}[4/5] Generating Nginx reverse proxy configuration...${NC}"

# Determine config file naming
if [ "$DOMAIN" == "_" ]; then
    CONFIG_NAME="default_proxy"
else
    # Sanitize domain name for filename
    CONFIG_NAME=$(echo "$DOMAIN" | tr -c 'a-zA-Z0-9._-' '_')
fi

SITES_AVAILABLE="/etc/nginx/sites-available/$CONFIG_NAME.conf"
SITES_ENABLED="/etc/nginx/sites-enabled/$CONFIG_NAME.conf"

# If binding to default '_', disable original default site to prevent conflicts
if [ "$DOMAIN" == "_" ] && [ -f "/etc/nginx/sites-enabled/default" ]; then
    echo "Disabling original default site to bind to default '_'..."
    $SUDO rm -f /etc/nginx/sites-enabled/default
fi

# Write configuration
$SUDO bash -c "cat << 'EOF' > $SITES_AVAILABLE
# ==============================================================================
# Production Reverse Proxy Configuration for $DOMAIN -> 127.0.0.1:$PORT
# Generated automatically by nginx_auto on $(date)
# ==============================================================================

upstream app_backend_${PORT} {
    server 127.0.0.1:${PORT};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    # Maximum file upload size
    client_max_body_size 100M;

    # Timeouts
    client_body_timeout 60s;
    client_header_timeout 60s;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Security Headers
    add_header X-Frame-Options \"SAMEORIGIN\" always;
    add_header X-Content-Type-Options \"nosniff\" always;
    add_header X-XSS-Protection \"1; mode=block\" always;
    add_header Referrer-Policy \"no-referrer-when-downgrade\" always;

    # Reverse Proxy to Backend Application
    location / {
        proxy_pass http://app_backend_${PORT};
        proxy_http_version 1.1;

        # WebSocket support
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \"upgrade\";

        # Standard Headers
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_set_header X-Forwarded-Host \$host;
        proxy_set_header X-Forwarded-Port \$server_port;

        # Timeouts for long requests
        proxy_connect_timeout 90s;
        proxy_send_timeout 90s;
        proxy_read_timeout 90s;
    }
}
EOF"

# Enable configuration
$SUDO ln -sf "$SITES_AVAILABLE" "$SITES_ENABLED"

# Test configuration
echo "Testing Nginx syntax..."
if $SUDO nginx -t; then
    if systemctl is-active --quiet nginx; then
        echo "Reloading Nginx service..."
        $SUDO systemctl reload nginx
    else
        echo "Starting Nginx service..."
        $SUDO systemctl start nginx
    fi
    echo -e "${GREEN}✔ Nginx configuration successfully tested and applied!${NC}"
else
    echo -e "${RED}✖ Nginx configuration test failed! Removing enabled symlink to prevent crash.${NC}"
    $SUDO rm -f "$SITES_ENABLED"
    exit 1
fi

# --- Step 7: Automated Let's Encrypt SSL (Certbot) ---
if [ "$ENABLE_SSL" = true ] && [ "$DOMAIN" != "_" ] && [ "$DOMAIN" != "localhost" ]; then
    echo ""
    echo -e "${BOLD}${CYAN}[5/5] Configuring Let's Encrypt SSL Certificate...${NC}"

    # Verify if domain resolves to an IP address before calling Let's Encrypt
    if ! getent ahosts "$DOMAIN" &>/dev/null; then
        echo -e "${YELLOW}⚠ Notice: Domain '$DOMAIN' has no public DNS record or does not resolve.${NC}"
        echo -e "${YELLOW}  Let's Encrypt requires a live domain whose DNS points to this server's IP.${NC}"
        echo -e "${YELLOW}  Your HTTP reverse proxy is fully configured and working on Port 80.${NC}"
        echo -e "${YELLOW}  Once your domain DNS propagates to this server, run:${NC}"
        echo -e "    ${BOLD}sudo certbot --nginx -d $DOMAIN${NC}"
    else
        if ! command -v certbot &> /dev/null; then
            echo "Installing Certbot and python3-certbot-nginx..."
            $SUDO apt-get update -y
            $SUDO apt-get install -y certbot python3-certbot-nginx
        fi

        CERTBOT_CMD="certbot --nginx -d $DOMAIN --non-interactive --agree-tos --redirect"
        if [ -n "$SSL_EMAIL" ]; then
            CERTBOT_CMD="$CERTBOT_CMD -m $SSL_EMAIL"
        else
            CERTBOT_CMD="$CERTBOT_CMD --register-unsafely-without-email"
        fi

        echo "Executing Certbot for $DOMAIN..."
        if $SUDO $CERTBOT_CMD; then
            echo -e "${GREEN}✔ SSL Certificate successfully installed! HTTPS is now active.${NC}"
        else
            echo -e "${YELLOW}⚠ Automated non-interactive SSL failed. You can run interactive certbot with:${NC}"
            echo "  sudo certbot --nginx -d $DOMAIN"
        fi
    fi
else
    echo ""
    echo -e "${BOLD}${CYAN}[5/5] Skipping SSL (HTTP only mode)...${NC}"
fi

# --- Final Summary ---
SERVER_IP=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "localhost")

echo ""
echo -e "${GREEN}======================================================================${NC}"
echo -e "${GREEN}🎉 FULL NGINX SERVER SETUP COMPLETED!${NC}"
echo -e "${GREEN}======================================================================${NC}"
echo -e "${BOLD}Domain / Host:${NC}       $DOMAIN"
echo -e "${BOLD}Forwarding To:${NC}       http://127.0.0.1:$PORT"
if [ "$ENABLE_SSL" = true ] && [ "$DOMAIN" != "_" ]; then
    echo -e "${BOLD}Access URL:${NC}          ${CYAN}https://$DOMAIN${NC}"
else
    if [ "$DOMAIN" == "_" ]; then
        echo -e "${BOLD}Access URL:${NC}          ${CYAN}http://$SERVER_IP${NC}"
    else
        echo -e "${BOLD}Access URL:${NC}          ${CYAN}http://$DOMAIN${NC} (or http://$SERVER_IP)"
    fi
fi
echo -e "${BOLD}Config Path:${NC}         $SITES_AVAILABLE"
echo -e "${BOLD}Exposed Ports:${NC}       Port 80 (HTTP) & Port 443 (HTTPS)"
echo ""
echo -e "${BOLD}Quick Commands:${NC}"
echo "  • Check status:      sudo systemctl status nginx"
echo "  • Test syntax:       sudo nginx -t"
echo "  • Reload changes:    sudo systemctl reload nginx"
echo "  • View access logs:  sudo tail -f /var/log/nginx/access.log"
echo "  • View error logs:   sudo tail -f /var/log/nginx/error.log"
echo -e "${GREEN}======================================================================${NC}"
